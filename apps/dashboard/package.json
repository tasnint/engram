{
  "name": "@engram/dashboard",
  "version": "0.1.0",
  "private": true,
  "description": "Live view of what agents are remembering: stats, a memory browser with explained search results, and a feed driven by MongoDB change streams.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --exclude 'web/**' server/main.ts",
    "build": "vite build",
    "start": "NODE_ENV=production tsx server/main.ts",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "vitest run",
    "test:integration": "echo 'no integration tests'"
  },
  "dependencies": {
    "@engram/core": "workspace:*",
    "mongodb": "7.7.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "vite": "8.3.5"
  }
}
