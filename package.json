{
  "name": "engram",
  "private": true,
  "description": "Long-term memory for AI agents, built on MongoDB.",
  "type": "module",
  "packageManager": "pnpm@10.4.1",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck && tsc -p tsconfig.json --noEmit",
    "test": "pnpm -r test",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v",
    "db:init": "pnpm --filter @engram/core db:init",
    "db:seed": "pnpm --filter @engram/core db:seed",
    "lifecycle": "pnpm --filter @engram/core lifecycle",
    "dev:api": "pnpm --filter @engram/server dev",
    "dev:dashboard": "pnpm --filter @engram/dashboard dev",
    "demo": "pnpm --filter @engram/demo start",
    "bench:write": "pnpm --filter @engram/bench write",
    "bench:recall": "pnpm --filter @engram/bench recall"
  },
  "devDependencies": {
    "@engram/core": "workspace:*",
    "@engram/server": "workspace:*",
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "eslint": "10.13.0",
    "mongodb": "7.7.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  }
}
