{
  "name": "@engram/core",
  "version": "0.1.0",
  "private": true,
  "description": "Engram's memory engine: storage, search and ranking on MongoDB.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "db:init": "tsx --env-file-if-exists=../../.env src/scripts/init-db.ts",
    "db:seed": "tsx --env-file-if-exists=../../.env src/scripts/seed.ts",
    "lifecycle": "tsx --env-file-if-exists=../../.env src/scripts/lifecycle.ts"
  },
  "dependencies": {
    "@huggingface/transformers": "3.8.1",
    "mongodb": "7.7.0",
    "zod": "4.6.7"
  }
}
