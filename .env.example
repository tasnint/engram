# ---- Database ---------------------------------------------------------------
# Local Docker database (pnpm db:up). directConnection is needed because the
# replica set member advertises its in-network hostname ("mongod:27017").
MONGODB_URI=mongodb://localhost:27017/?directConnection=true
MONGODB_DATABASE=engram
# Host port for the Docker database. If you change it, change MONGODB_URI too.
MONGODB_PORT=27017

# ---- Embeddings (P4) --------------------------------------------------------
# local:  Xenova/all-MiniLM-L6-v2 via Transformers.js. Free, downloads once (~25 MB).
# voyage: Voyage AI. Needs VOYAGE_API_KEY. Set EMBEDDING_DIMENSIONS=1024.
# hash:   offline word-matching stand-in for tests. Matches words, not meaning.
# A database is bound to one model and dimension count (see pnpm db:init).
EMBEDDING_PROVIDER=local
EMBEDDING_DIMENSIONS=384
LOCAL_MODEL=Xenova/all-MiniLM-L6-v2
LOCAL_MODEL_PATH=
LOCAL_OFFLINE=false
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-4-lite

# ---- REST API (A6) ----------------------------------------------------------
PORT=3000
HOST=127.0.0.1
# JSON object mapping each namespace to its own random key (32+ characters).
# Generate one: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
API_KEYS={"demo-agent":"replace-with-a-random-key-at-least-32-characters"}

# ---- Write path (A3, A4) ----------------------------------------------------
# exact: dedupe identical text only. vector: also merge near-duplicates using
# the vector index (needs mongot and pnpm db:init).
DEDUP_MODE=vector
DEDUP_THRESHOLD=0.92
DECAY_INTERVAL_MS=86400000
IMPORTANCE_HALF_LIFE_DAYS=90

# ---- Consolidation (A5) -----------------------------------------------------
# Any OpenAI-compatible chat completions endpoint, e.g. a local Ollama:
# SUMMARIZER_URL=http://localhost:11434/v1/chat/completions
SUMMARIZER_URL=
SUMMARIZER_MODEL=
SUMMARIZER_API_KEY=

# ---- Dashboard and MCP server -----------------------------------------------
DASHBOARD_PORT=4317
ENGRAM_NAMESPACE=demo-agent
ENGRAM_USER_ID=u_demo

# ---- Demo agent (X1) --------------------------------------------------------
ANTHROPIC_API_KEY=
